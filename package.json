{
  "name": "fintrack",
  "version": "1.0.0",
  "private": true,
  "description": "FinTrack — Production-Grade Personal Finance & Analytics Platform",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:push": "npm --prefix server run prisma:push",
    "seed": "npm --prefix server run seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "finance",
    "analytics",
    "recharts",
    "react",
    "typescript",
    "postgresql",
    "prisma",
    "express"
  ],
  "author": "FinTrack Core Team",
  "license": "MIT"
}
